---
import { ArrowLeft, ArrowRight, ChevronDown, Download, Network } from '@lucide/astro'

import analysis from '#site/assets/archive/analysis.jpeg'
import capture from '#site/assets/archive/capture.jpeg'
import graph from '#site/assets/archive/graph2.jpeg'
import heroIllustration from '#site/assets/archive/home_svg.svg?url'
import WindowFrame from '#site/components/archive/WindowFrame.astro'
import GithubMark from '#site/components/GithubMark.astro'
import BaseLayout from '#site/layouts/BaseLayout.astro'
import '#site/styles/archive.css'

// Faithful reproduction of the Pruftnet 0.1 landing page (pruftnet-site, AdonisJS), kept for
// reference. Its copy describes features that only exist in the archived 0.1 application.
const faqs = [
    {
        question: 'What is Pruftnet?',
        answer: 'Pruftnet is a visual network analysis tool that combines real-time packet capture with an intuitive visual workflow builder. It helps you understand, analyze, and troubleshoot networks without writing complex scripts.',
    },
    {
        question: 'Is Pruftnet really free?',
        answer: 'Yes! Pruftnet is completely free and open source. You can use it, modify it, and contribute to its development.',
    },
    {
        question: 'What operating systems are supported?',
        answer: 'Pruftnet works on Windows, macOS, and Linux. It is available as both a desktop application and a web application.',
    },
    {
        question: 'Do I need coding skills to use Pruftnet?',
        answer: 'No. The visual workflow builder allows you to create sophisticated network analysis routines using a drag-and-drop interface. No coding required.',
    },
    {
        question: 'How does Pruftnet compare to Wireshark?',
        answer: 'While Wireshark is excellent for packet inspection, Pruftnet adds visual network topology mapping and a unique workflow builder for automated analysis. Think of it as Wireshark meets visual programming.',
    },
    {
        question: 'Is my network data secure?',
        answer: 'Absolutely. Pruftnet runs locally on your machine. Your network data never leaves your device unless you explicitly choose to export it.',
    },
]
const bullet = 'bg-primary size-2 flex-none rounded-full'
---

<BaseLayout
    title="Pruftnet 0.1 (archived)"
    description="The archived landing page of Pruftnet 0.1, the previous generation with a topology graph and a visual workflow builder."
    path="/archive"
    noindex
    bodyClass="archive"
>
    <div class="dark bg-background text-foreground relative z-[60] text-sm">
        <div class="page flex min-h-11 flex-wrap items-center justify-between gap-x-6 gap-y-1 py-2">
            <p>
                <span class="font-medium">Archived page.</span>
                <span class="text-muted-foreground">
                    Pruftnet 0.1 is no longer maintained. Its graph and workflow builder are not part of
                    0.2.
                </span>
            </p>
            <a href="/" class="inline-flex items-center gap-1.5 font-medium hover:underline">
                <ArrowLeft class="size-3.5" aria-hidden="true" />
                Current version
            </a>
        </div>
    </div>

    <div class="relative flex min-h-screen flex-col">
        <div class="pointer-events-none absolute inset-0 hidden justify-center lg:flex">
            <div class="container-main relative h-full w-full">
                <div class="guides-vertical absolute top-0 left-0 h-full"></div>
            </div>
        </div>

        <div class="relative z-1">
            <header class="absolute top-0 right-0 left-0 z-50 w-full">
                <nav class="container-main flex h-16 items-center justify-between">
                    <a href="/archive" class="flex items-center gap-2 transition-opacity hover:opacity-80">
                        <Network class="text-primary size-7" stroke-width={2.5} />
                        <span class="text-xl font-bold tracking-tight">Prüftnet</span>
                    </a>
                    <div class="hidden items-center gap-1 md:flex">
                        <a href="/" class="text-foreground/80 hover:bg-foreground/5 hover:text-foreground rounded-md px-4 py-2 text-sm font-medium transition-colors">Home</a>
                        <a href="/about" class="text-foreground/80 hover:bg-foreground/5 hover:text-foreground rounded-md px-4 py-2 text-sm font-medium transition-colors">About</a>
                        <a href="https://github.com/franktronics/pruftnet.app/tree/dev-archive" class="text-foreground/80 hover:bg-foreground/5 hover:text-foreground rounded-md px-3 py-2 text-sm font-medium transition-colors" aria-label="View on GitHub">
                            <GithubMark class="size-5" />
                        </a>
                    </div>
                    <a href="/downloads#legacy" class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-8 items-center gap-2 rounded-md px-3 text-sm font-medium">
                        <Download class="size-4" />
                        Download
                    </a>
                </nav>
            </header>

            <main class="flex-1">
                <section class="relative overflow-hidden">
                    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(234,88,12,0.1),transparent)]"></div>
                    <div class="container-main">
                        <div class="flex flex-row items-center gap-8 py-36 lg:gap-12 lg:py-64">
                            <div class="flex flex-1 flex-col items-center text-center lg:items-start lg:text-left">
                                <div class="border-primary/20 bg-primary/5 text-primary mb-6 inline-flex items-center rounded-full border px-4 py-1.5 text-sm font-medium">
                                    Visual Network Analyser
                                </div>
                                <h1 class="text-foreground text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl lg:text-7xl">
                                    See Your Network
                                    <span class="text-primary block">Like Never Before</span>
                                </h1>
                                <p class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed sm:text-xl">
                                    Capture packets in real-time, visualize your network topology, and build
                                    custom analysis workflows with an intuitive drag-and-drop interface. No
                                    coding required.
                                </p>
                                <div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center">
                                    <a href="/downloads#legacy" class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex h-10 items-center gap-2 rounded-md px-6 text-base font-medium">
                                        <Download class="size-4" />
                                        Download Pruftnet 0.1.2
                                        <ArrowRight class="size-4" />
                                    </a>
                                    <a href="https://github.com/franktronics/pruftnet.app/tree/dev-archive" class="border-border bg-background hover:bg-accent inline-flex h-10 items-center gap-2 rounded-md border px-6 text-base font-medium shadow-xs">
                                        <GithubMark class="size-4" />
                                        View on GitHub
                                    </a>
                                </div>
                                <div class="text-muted-foreground mt-10 flex flex-wrap items-center justify-center gap-6 text-sm lg:justify-start">
                                    <span>Open Source</span>
                                    <span>Cross-Platform</span>
                                    <span>Web version</span>
                                </div>
                            </div>
                            <div class="relative hidden flex-1 items-center justify-center lg:flex">
                                <div class="relative w-full max-w-lg">
                                    <img src={heroIllustration} alt="Network visualization showing interconnected devices and servers" class="w-full scale-170" loading="eager" />
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <div class="guides-horizontal-full hidden lg:block"></div>

                <section class="relative overflow-hidden py-10 md:py-28">
                    <div class="container-main">
                        <div class="flex">
                            <div class="max-w-xl lg:max-w-2xl">
                                <h2 class="text-foreground text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
                                    Real-Time Packet Capture
                                </h2>
                                <div class="text-muted-foreground mt-6 space-y-4 text-lg">
                                    <p>
                                        Powered by a <span class="text-foreground font-medium">high-performance C++ core</span>,
                                        Pruftnet captures network packets in real-time with minimal overhead.
                                    </p>
                                    <p>
                                        Monitor live traffic, analyze protocols, and inspect every byte flowing
                                        through your network interfaces.
                                    </p>
                                    <p>
                                        Support for Ethernet, IPv4, IPv6, TCP, UDP, ICMP, ARP, and many more
                                        protocols out of the box.
                                    </p>
                                </div>
                                <ul class="mt-10 space-y-3">
                                    <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Live traffic monitoring</li>
                                    <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Deep packet inspection</li>
                                    <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Export captures in PCAP format for use with other tools</li>
                                    <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Run the capture remotely on a server and stream results to the web interface.</li>
                                </ul>
                            </div>
                            <div class="absolute top-1/2 right-[min(calc(32vw-52rem),0px)] hidden flex-1 -translate-y-1/3 lg:block">
                                <WindowFrame src={capture} alt="Screenshot of Pruftnet's packet capture interface showing real-time network traffic visualization and analysis tools" class="rotate-2" imageClass="w-225" />
                            </div>
                        </div>
                        <div class="mt-12 lg:hidden">
                            <WindowFrame src={capture} alt="Screenshot of Pruftnet's packet capture interface" imageClass="w-full" />
                        </div>
                    </div>
                </section>

                <div class="guides-horizontal-full hidden lg:block"></div>

                <section class="py-10 md:py-28">
                    <div class="container-main">
                        <h2 class="text-foreground text-3xl font-semibold tracking-tight sm:text-4xl md:max-w-2xl md:text-5xl">
                            Visual Network Topology
                        </h2>
                        <div class="text-muted-foreground mt-6 space-y-4 text-lg md:max-w-2xl">
                            <p>
                                Watch your network come alive as devices communicate.
                                <span class="text-foreground font-medium">Pruftnet automatically maps every connection</span>
                                into an interactive force-directed graph.
                            </p>
                            <p>
                                Identify devices instantly with vendor lookup, spot unusual traffic patterns,
                                and understand your network architecture at a glance.
                            </p>
                        </div>
                        <ul class="mt-10 space-y-3">
                            <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Real-time topology updates</li>
                            <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Automatic device identification</li>
                            <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Interactive pan, zoom, and selection</li>
                            <li class="text-foreground flex items-center gap-3 font-medium"><span class={bullet}></span>Traffic flow visualization</li>
                        </ul>
                    </div>
                    <div class="container-main mt-12">
                        <WindowFrame src={graph} alt="Network topology graph showing interconnected devices and traffic flows" imageClass="w-full" />
                    </div>
                </section>

                <div class="guides-horizontal-full hidden lg:block"></div>

                <section class="relative overflow-hidden py-10 md:py-28">
                    <div class="container-main">
                        <div class="flex justify-end">
                            <div class="max-w-xl lg:max-w-2xl">
                                <div class="border-primary/20 bg-primary/5 text-primary inline-flex items-center rounded-full border px-3 py-1 text-sm font-medium">
                                    Workflow Builder
                                </div>
                                <h2 class="text-foreground mt-4 text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
                                    Build. Test.
                                    <span class="text-primary block">Understand.</span>
                                </h2>
                                <p class="text-muted-foreground mt-6 text-lg leading-relaxed">
                                    Create sophisticated network test scenarios without writing a single line of
                                    code. Drag nodes, connect them visually, and watch your equipment respond in
                                    real-time.
                                </p>
                                <div class="mt-8 grid gap-6 sm:grid-cols-2">
                                    <div class="border-border bg-card/50 rounded-lg border p-4">
                                        <div class="text-primary text-2xl font-bold">Infinite</div>
                                        <div class="text-muted-foreground mt-1 text-sm">Test scenarios possible</div>
                                    </div>
                                    <div class="border-border bg-card/50 rounded-lg border p-4">
                                        <div class="text-primary text-2xl font-bold">Zero</div>
                                        <div class="text-muted-foreground mt-1 text-sm">Lines of code required</div>
                                    </div>
                                </div>
                                <p class="text-muted-foreground mt-8">
                                    Simulate communications, test your network architecture, or simply understand
                                    how your network reacts to specific traffic patterns.
                                    <span class="text-foreground font-medium">The only limit is your imagination.</span>
                                </p>
                            </div>
                            <div class="absolute top-1/2 left-[min(calc(32vw-52rem),0px)] hidden flex-1 -translate-y-1/3 lg:block">
                                <WindowFrame src={analysis} alt="Visual workflow builder for creating network test scenarios" class="-rotate-2" imageClass="w-225" />
                            </div>
                        </div>
                        <div class="mt-12 lg:hidden">
                            <WindowFrame src={analysis} alt="Visual workflow builder for creating network test scenarios" imageClass="w-full" />
                        </div>
                    </div>
                </section>

                <div class="guides-horizontal-full hidden lg:block"></div>

                <section class="py-20 md:py-28">
                    <div class="container-main">
                        <div class="mx-auto max-w-3xl">
                            <div class="text-center">
                                <h2 class="text-foreground text-3xl font-semibold tracking-tight sm:text-4xl md:text-5xl">
                                    Frequently Asked Questions
                                </h2>
                                <p class="text-muted-foreground mt-4 text-lg">Everything you need to know about Pruftnet</p>
                            </div>
                            <div class="mt-12">
                                {
                                    faqs.map((faq) => (
                                        <details class="border-border border-b last:border-b-0" name="faq">
                                            <summary class="text-foreground flex cursor-pointer items-center justify-between gap-4 py-4 text-base font-medium hover:underline">
                                                {faq.question}
                                                <ChevronDown class="chevron text-muted-foreground size-4 shrink-0 transition-transform" />
                                            </summary>
                                            <p class="text-muted-foreground pb-4 text-sm">{faq.answer}</p>
                                        </details>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                </section>
            </main>

            <footer class="border-border border-t py-12">
                <div class="container-main">
                    <div class="flex flex-col items-center justify-between gap-8 md:flex-row">
                        <div class="flex items-center gap-2">
                            <Network class="text-primary size-6" />
                            <span class="text-foreground text-lg font-semibold">Prüftnet</span>
                        </div>
                        <ul class="flex items-center gap-6">
                            <li>
                                <a href="https://github.com/franktronics/pruftnet.app" class="text-muted-foreground hover:text-foreground flex items-center gap-2 text-sm transition-colors">
                                    <GithubMark class="size-5" />
                                    GitHub
                                </a>
                            </li>
                            <li>
                                <a href="https://x.com/franktronics_w" class="text-muted-foreground hover:text-foreground flex items-center gap-2 text-sm transition-colors">
                                    <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                                    </svg>
                                    X
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="border-border text-muted-foreground mt-8 border-t pt-8 text-center text-sm">
                        <p>© 2026 Pruftnet. Open source under MIT License.</p>
                    </div>
                </div>
            </footer>
        </div>
    </div>
</BaseLayout>
