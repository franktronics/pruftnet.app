---
// Monochrome rendition of the application icon: three stacked layers fading with depth.
interface Props {
    class?: string
}
const { class: className } = Astro.props
---

<svg class={className} viewBox="21 23 58 58" fill="currentColor" aria-hidden="true">
    <polygon points="24,66 34.65,60.7 50,68.35 65.35,60.7 76,66 50,79" fill-opacity="0.45" />
    <polygon points="24,52 34.65,46.7 50,54.35 65.35,46.7 76,52 50,65" fill-opacity="0.7" />
    <polygon points="50,25 76,38 50,51 24,38" />
</svg>
