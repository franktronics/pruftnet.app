---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
    src: ImageMetadata
    alt: string
    /** Full application window: draws the macOS window controls the capture cannot include. */
    window?: boolean
    sizes: string
    widths: number[]
    priority?: boolean
    class?: string
}

const { src, alt, window = false, sizes, widths, priority = false, class: className } = Astro.props
---

<figure
    class:list={['relative overflow-hidden rounded-[0.625rem] ring-1 ring-white/10', className]}
>
    <Picture
        src={src}
        alt={alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="block h-auto w-full"
    />
    {
        /* Positions mirror trafficLightPosition { x: 16, y: 15 } in a 1600 × 1100 window. */
        window &&
            ['#ff5f57', '#febc2e', '#28c840'].map((color, index) => (
                <i
                    aria-hidden="true"
                    class="absolute top-[1.36%] block aspect-square w-[0.75%] rounded-full"
                    style={`left: ${1 + index * 1.25}%; background: ${color}`}
                />
            ))
    }
</figure>
