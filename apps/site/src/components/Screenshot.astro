---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

interface Props {
    src: ImageMetadata
    alt: string
    sizes: string
    widths: number[]
    priority?: boolean
    class?: string
}

const { src, alt, sizes, widths, priority = false, class: className } = Astro.props
---

<figure
    class:list={['relative overflow-hidden rounded-[0.625rem] ring-1 ring-white/10', className]}
>
    <Picture
        src={src}
        alt={alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={widths}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="block h-auto w-full"
    />
</figure>
