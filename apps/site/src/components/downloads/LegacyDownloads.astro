---
import { platformLabels, platforms } from '#site/releases/assets'
import type { LegacyRelease } from '#site/releases/catalog'
import AssetTable from './AssetTable.astro'

interface Props {
    release: LegacyRelease
}

const { release } = Astro.props
---

<div class="grid gap-x-10 gap-y-8 lg:grid-cols-3">
    {
        platforms.map((platform) => {
            const rows = release.assets
                .filter((asset) => asset.platform === platform)
                .map((asset) => ({ ...asset, note: asset.server ? 'Server' : undefined }))
            return (
                rows.length > 0 && (
                    <section>
                        <h3 class="text-foreground mb-2 font-semibold">{platformLabels[platform]}</h3>
                        <AssetTable rows={rows} />
                    </section>
                )
            )
        })
    }
</div>
