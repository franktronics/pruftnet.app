---
interface Props {
    label: string
    title: string
    class?: string
}

const { label, title, class: className } = Astro.props
---

<header class:list={['grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10', className]}>
    <div class="lg:col-span-7">
        <p class="label" data-reveal>{label}</p>
        <h2
            class="heading text-foreground mt-4 max-w-[16ch] text-[clamp(2.125rem,1.4rem+2.8vw,3.75rem)]"
            data-reveal
            style="--reveal-delay: 60ms"
        >
            {title}
        </h2>
    </div>
    <div class="lede space-y-4 lg:col-span-5 lg:pb-1.5" data-reveal style="--reveal-delay: 120ms">
        <slot />
    </div>
</header>
