---
import { ArrowRight } from '@lucide/astro'

import CodeLine from '#site/components/CodeLine.astro'
import { platformNotes } from '#site/content/platform-notes'
import { platformLabels, platforms } from '#site/releases/assets'
---

<section id="install" class="scroll-mt-16">
    <div class="page border-hairline border-t pt-24 pb-20 md:pt-32 md:pb-24">
        <div class="flex flex-wrap items-end justify-between gap-8">
            <div class="max-w-xl">
                <p class="label" data-reveal>Install</p>
                <h2 class="heading mt-4 text-[clamp(2rem,1.4rem+2.4vw,3.25rem)]" data-reveal style="--reveal-delay: 60ms">
                    Running in a few minutes.
                </h2>
            </div>
            <a
                href="/downloads"
                class="bg-foreground text-background hover:bg-foreground/90 inline-flex h-11 items-center gap-2 rounded-lg pr-4 pl-5 text-[0.9375rem] font-medium transition-colors"
                data-reveal
            >
                All downloads
                <ArrowRight class="size-4" aria-hidden="true" />
            </a>
        </div>
        <div class="mt-14 grid gap-4 md:grid-cols-3">
            {
                platforms.map((platform, index) => {
                    const note = platformNotes[platform]
                    return (
                        <div
                            class="panel flex min-w-0 flex-col p-7 md:p-8"
                            data-reveal
                            style={`--reveal-delay: ${index * 70}ms`}
                        >
                            <h3 class="text-lg font-semibold">{platformLabels[platform]}</h3>
                            <p class="label mt-1">{note.requirement}</p>
                            <ul class="text-muted-foreground mt-6 space-y-3 text-[0.9375rem] leading-relaxed">
                                {note.steps.map((step) => (
                                    <li>{step}</li>
                                ))}
                            </ul>
                            {note.command && <CodeLine code={note.command} class="mt-4" />}
                            <a
                                href={`/downloads#${platform}`}
                                class="text-foreground mt-auto inline-flex items-center gap-1.5 pt-8 text-sm font-medium hover:underline"
                            >
                                Download for {platformLabels[platform]}
                                <ArrowRight class="size-3.5" aria-hidden="true" />
                            </a>
                        </div>
                    )
                })
            }
        </div>
    </div>
</section>
