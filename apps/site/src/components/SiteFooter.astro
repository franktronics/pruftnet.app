---
import GithubMark from './GithubMark.astro'
import Mark from './Mark.astro'

const year = new Date().getFullYear()
const columns = [
    {
        title: 'Product',
        links: [
            { href: '/downloads', label: 'Download' },
            { href: '/downloads#nightly', label: 'Nightly builds' },
            { href: 'https://github.com/franktronics/pruftnet.app/releases', label: 'Release notes' },
        ],
    },
    {
        title: 'Project',
        links: [
            { href: 'https://github.com/franktronics/pruftnet.app', label: 'Source code' },
            { href: 'https://github.com/franktronics/pruftnet.app/issues', label: 'Report an issue' },
            { href: '/about', label: 'About' },
        ],
    },
    {
        title: 'Earlier versions',
        links: [
            { href: '/archive', label: 'Pruftnet 0.1' },
            { href: '/downloads#legacy', label: 'Download 0.1.2' },
        ],
    },
]
---

<footer class="dark bg-background text-foreground border-hairline border-t">
    <div class="page grid gap-12 py-16 md:grid-cols-[1fr_auto] md:py-20">
        <div class="max-w-xs">
            <a href="/" class="flex items-center gap-2.5" aria-label="Pruftnet home">
                <Mark class="text-primary size-[1.375rem]" />
                <span class="font-display text-[1.0625rem] font-semibold [font-stretch:90%]">Pruftnet</span>
            </a>
            <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
                Open-source packet analyzer for macOS, Windows and Linux. Released under the MIT
                License.
            </p>
        </div>
        <div class="grid grid-cols-2 gap-x-14 gap-y-10 sm:grid-cols-3">
            {
                columns.map((column) => (
                    <div>
                        <p class="label">{column.title}</p>
                        <ul class="mt-4 space-y-2.5 text-sm">
                            {column.links.map((link) => (
                                <li>
                                    <a
                                        href={link.href}
                                        class="text-muted-foreground hover:text-foreground transition-colors"
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
    <div class="border-hairline border-t">
        <div class="page text-muted-foreground flex h-14 items-center justify-between text-xs">
            <span>© {year} Wilson Tenepo</span>
            <a
                href="https://github.com/franktronics/pruftnet.app"
                class="hover:text-foreground flex items-center gap-2 transition-colors"
            >
                <GithubMark class="size-3.5" />
                franktronics/pruftnet.app
            </a>
        </div>
    </div>
</footer>
