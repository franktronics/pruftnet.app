---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

// The 0.1 landing framed every screenshot in a card with a faux title bar.
interface Props {
    src: ImageMetadata
    alt: string
    class?: string
    imageClass?: string
}

const { src, alt, class: className, imageClass } = Astro.props
---

<div class:list={['border-border bg-card overflow-hidden rounded-xl border shadow-2xl', className]}>
    <div class="border-border bg-muted/50 flex h-8 items-center gap-1.5 border-b px-4">
        <div class="size-2 rounded-full bg-red-500/80 md:size-3"></div>
        <div class="size-2 rounded-full bg-yellow-500/80 md:size-3"></div>
        <div class="size-2 rounded-full bg-green-500/80 md:size-3"></div>
    </div>
    <Image src={src} alt={alt} widths={[900, 1400, 1800]} sizes="(min-width: 1024px) 56rem, 100vw" class:list={['block h-auto', imageClass]} />
</div>
