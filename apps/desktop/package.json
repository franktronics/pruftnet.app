{
  "name": "@repo/desktop",
  "private": true,
  "version": "0.1.2",
  "productName": "Pruftnet",
  "description": "Network analysis software",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer && electron-builder",
    "build:main": "vite build --config config/vite.main.config.ts",
    "build:preload": "vite build --config config/vite.preload.config.ts",
    "build:renderer": "vite build --config config/vite.renderer.config.ts",
    "package": "electron-builder --dir",
    "make": "electron-builder",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "author": "Franklin Tenepo",
  "homepage": "https://pruftnet.app",
  "license": "MIT",
  "dependencies": {
    "@repo/front": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@eslint/js": "catalog:",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.0.12",
    "eslint": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "^8.0.16"
  }
}
