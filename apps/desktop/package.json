{
    "name": "@repo/desktop",
    "private": true,
    "version": "0.1.2",
    "productName": "Pruftnet",
    "description": "Network analysis software",
    "type": "module",
    "main": "dist-electron/main/main.js",
    "scripts": {
        "dev": "tsx scripts/dev.ts",
        "start": "tsx scripts/start-electron.ts",
        "build": "tsx scripts/build.ts",
        "build:main": "vite build --config config/vite.main.config.ts",
        "build:preload": "vite build --config config/vite.preload.config.ts",
        "build:renderer": "vite build --config config/vite.renderer.config.ts",
        "package": "tsx scripts/build.ts --dir",
        "make": "tsx scripts/build.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "author": "Franklin Tenepo",
    "homepage": "https://pruftnet.app",
    "license": "MIT",
    "dependencies": {
        "@repo/front": "workspace:*",
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "devDependencies": {
        "@electron/fuses": "^2.1.1",
        "@eslint/js": "catalog:",
        "@tailwindcss/vite": "^4.3.1",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "^6.0.2",
        "electron": "^42.4.1",
        "electron-builder": "^26.0.12",
        "eslint": "catalog:",
        "globals": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "tsx": "^4.22.4",
        "vite": "^8.0.16"
    }
}
