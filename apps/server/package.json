{
    "name": "@repo/server",
    "private": true,
    "version": "0.2.1",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/main.ts serve",
        "build": "vite build --config config/vite.server.config.ts",
        "start": "node dist/main.js serve",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@effect/cli": "~0.75.2",
        "@effect/platform": "catalog:",
        "@effect/platform-node": "catalog:",
        "@effect/printer": "~0.49.0",
        "@effect/printer-ansi": "~0.49.0",
        "@repo/core": "workspace:*",
        "@repo/shared": "workspace:*",
        "effect": "catalog:"
    },
    "devDependencies": {
        "@eslint/js": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "globals": "catalog:",
        "tsx": "^4.22.4",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "^8.0.16",
        "vitest": "^4.1.10"
    },
    "imports": {
        "#server/*": "./src/*"
    }
}
